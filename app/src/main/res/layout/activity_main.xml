<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/simpleHome" android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/cardMealResult" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/kitchenBackground" android:visibility="gone" android:fillViewport="true">
        <com.example.dishroulette.AdaptivePageFrame android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCloseResult" style="@style/TableControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/back_home" />
            <TextView android:id="@+id/tvResultSection" style="@style/Instrument" android:layout_marginTop="32dp" android:text="@string/recipe_ready" />
            <TextView android:id="@+id/tvResultEyebrow" style="@style/Instrument" android:layout_marginTop="12dp" android:text="@string/ai_result_eyebrow" android:textColor="?attr/kitchenMuted" />
            <TextView android:id="@+id/tvMealTitle" style="@style/SectionTitle" android:fontFamily="serif" android:textSize="38sp" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" />
            <View android:layout_gravity="center_horizontal" android:layout_width="64dp" android:layout_height="3dp" android:layout_marginTop="24dp" android:background="?attr/kitchenAccent" />
            <TextView android:id="@+id/tvMealDescription" style="@style/BodyText" android:textColor="?attr/kitchenInk" android:textSize="17sp" android:layout_marginTop="20dp" />
            <TextView android:id="@+id/tvMealMeta" style="@style/Instrument" android:textSize="12sp" android:padding="16dp" android:layout_marginTop="24dp" android:background="@drawable/console_panel" android:visibility="gone" />
            <TextView android:id="@+id/tvMatch" style="@style/Instrument" android:layout_marginTop="24dp" android:visibility="gone" />
            <TextView android:id="@+id/tvMissing" style="@style/BodyText" android:layout_marginTop="6dp" android:visibility="gone" />
            <TextView android:id="@+id/tvPersonalization" style="@style/BodyText" android:layout_marginTop="20dp" android:visibility="gone" />
            <TextView android:id="@+id/tvAllergyWarning" style="@style/BodyText" android:layout_marginTop="16dp" android:textSize="12sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/resultActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="28dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRecipe" style="@style/ActionButton" android:text="@string/view_recipe" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLike" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="10dp" android:text="@string/save_recipe" app:cornerRadius="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDislike" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/another" />
            </LinearLayout>
            <LinearLayout android:id="@+id/simpleRecipeDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="24dp" />
        </LinearLayout>
        </com.example.dishroulette.AdaptivePageFrame>
    </ScrollView>
    <FrameLayout android:id="@+id/secondaryScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/kitchenBackground" android:visibility="gone" />
</FrameLayout>
